// Prisma schema for the Raibod Phase 1 skeleton.
// Two tables: users and sessions (auth only). This is NOT the final 39-table ERD.
// The demo_bookings table was removed in Phase 1 (migration drop_demo_bookings).
// Enum values are English codes in the database. Persian labels live only in the UI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  SELLER
  RECEPTION
}

model User {
  id           String    @id @default(uuid())
  fullName     String    @map("full_name")
  mobile       String    @unique
  passwordHash String    @map("password_hash")
  role         Role
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  // Login lockout (added 2026-11-07, post-PoC gap). Failed attempts are
  // counted per account; the account locks for 15 minutes after 5 failures.
  // Per-IP limiting for unknown mobiles is still open (see HANDOVER §3).
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]
  // Activity log (added 2026-11-12, owner decision). The manager sees
  // what employees do. A user with log entries cannot be deleted:
  // the FK is Restrict, so the log is never orphaned.
  auditLogs    AuditLog[]

  @@index([role])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Activity log (AuditLog). One row per user action the manager may
// need to review: login, logout, and later business operations
// (create/update/delete of customers, prescriptions, sales, etc.),
// added as those features are built. The action is an English code;
// the Persian label lives in src/lib/audit.ts (ACTION_LABELS).
// The log is append-only: no update or delete path exists.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  details    String?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
