// Prisma schema for the Raibod local PoC foundation.
// Only three demo tables. This is NOT the final 39-table ERD.
// Enum values are English codes in the database. Persian labels live only in the UI.
// The tstzrange column and the Exclusion Constraint are added by hand-edited raw SQL
// in the migration, because Prisma cannot express them natively.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  SELLER
  RECEPTION
}

model User {
  id           String    @id @default(uuid())
  fullName     String    @map("full_name")
  mobile       String    @unique
  passwordHash String    @map("password_hash")
  role         Role
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  // Login lockout (added 2026-11-07, post-PoC gap). Failed attempts are
  // counted per account; the account locks for 15 minutes after 5 failures.
  // Per-IP limiting for unknown mobiles is still open (see HANDOVER §3).
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]

  @@index([role])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum DemoBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model DemoBooking {
  id        String            @id @default(uuid())
  doctorId  String            @map("doctor_id") @db.Uuid
  slot      Unsupported("tstzrange")
  status    DemoBookingStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at")

  @@map("demo_bookings")
}
